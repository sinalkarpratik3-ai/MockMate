# ==============================================================================
# MockMate - Environment Configuration Reference
# ==============================================================================

# Backend Database (PostgreSQL for Render production, SQLite default for local development)
DATABASE_URL=sqlite:///./mockmate.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://mockmate_user:your_secure_password@dpg-xxxxx.oregon-postgres.render.com/mockmate

# Security & JWT Authentication
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Production Frontend example:
# NEXT_PUBLIC_API_URL=https://mockmate-backend.onrender.com/api
