# ==============================================================================
# MockMate - Environment Configuration Reference
# ==============================================================================

# Backend Database (PostgreSQL for AWS RDS production, SQLite default for local development)
DATABASE_URL=sqlite:///./mockmate.db
# AWS RDS PostgreSQL example:
# DATABASE_URL=postgresql://mockmate_user:your_secure_password@mockmate-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/mockmate

# Environment Mode
ENVIRONMENT=development
AUTO_MIGRATE_ON_STARTUP=true

# Security & JWT Authentication
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Configuration (Optional)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# AWS Production Frontend example (Load Balancer or Custom Domain):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# Or via Application Load Balancer DNS:
# NEXT_PUBLIC_API_URL=http://mockmate-alb-123456789.us-east-1.elb.amazonaws.com/api
