# MockMate Backend Environment Configuration Reference
# Local development default (SQLite):
DATABASE_URL=sqlite:///./mockmate.db
ENVIRONMENT=development
AUTO_MIGRATE_ON_STARTUP=true

# Security
SECRET_KEY=generate-a-secure-random-32-byte-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Content Generation (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS Allowed Origins (Comma-separated for multiple production origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS Production Deployment (AWS RDS PostgreSQL):
# DATABASE_URL=postgresql://mockmate_user:SecurePassword123!@mockmate-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/mockmate
# ENVIRONMENT=production
# BACKEND_CORS_ORIGINS=http://mockmate-alb-123456789.us-east-1.elb.amazonaws.com,https://mockmate.yourdomain.com
